[Desktop Entry]
Type=Application
Name=TuxDisplay
Comment=Extend a GNOME Wayland desktop to a tablet over USB
Exec=tuxdisplay gui
Icon=tuxdisplay
Terminal=false
Categories=Network;RemoteAccess;
Keywords=iPad;Android;tablet;display;monitor;USB;Wayland;OpenDisplay;VNC;noVNC;
StartupNotify=true
StartupWMClass=io.github.tuxdisplay.Manager
DBusActivatable=false

Actions=Start;Close;

[Desktop Action Start]
Name=Start display
Exec=tuxdisplay start

[Desktop Action Close]
Name=Close connection
Exec=tuxdisplay stop
