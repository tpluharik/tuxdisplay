<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>TuxDisplay</vendor>
  <action id="io.github.tuxdisplay.usb.configure">
    <description>Configure TuxDisplay USB gadget networking</description>
    <message>Authentication is required to configure the USB gadget network.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/tuxdisplay-usb</annotate>
  </action>
  <action id="io.github.tuxdisplay.update.install">
    <description>Install a signed TuxDisplay update</description>
    <message>Authentication is required to install the signed TuxDisplay update.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tuxdisplay/update-helper</annotate>
  </action>
</policyconfig>
