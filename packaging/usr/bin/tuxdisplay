#!/usr/bin/python3
"""TuxDisplay command line and GTK manager."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shlex
import socket
import subprocess
import sys
import tempfile
import threading
import time
from typing import Sequence
import urllib.error
import urllib.parse
import urllib.request


APP_NAME = "TuxDisplay"
VERSION = "0.4.12"
SERVICE = "tuxdisplay.service"
USB_GADGET_ADDRESS = "10.55.0.1"
UPDATE_API = "https://api.github.com/repos/tpluharik/tuxdisplay/releases/latest"
UPDATE_HOSTS = {"api.github.com", "github.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com"}
MAX_UPDATE_METADATA = 1 << 20
MAX_UPDATE_PACKAGE = 100 << 20
DEFAULTS = {
    "RESOLUTION": "1920x1080",
    "FPS": "30",
    "KEEP_AWAKE_WITH_LID_CLOSED": "0",
    "DISPLAY_NUMBER": "48",
    "WEB_PORT": "6080",
    "VNC_PORT": "5900",
}
RESOLUTIONS = (
    "1024x768",
    "1280x800",
    "1366x768",
    "1920x1080",
    "2048x1536",
    "2160x1620",
)
FRAME_RATES = ("15", "30", "60")


def version_tuple(version: str) -> tuple[int, int, int]:
    match = re.fullmatch(r"v?([0-9]+)\.([0-9]+)\.([0-9]+)", version.strip())
    if match is None:
        raise ValueError(f"unsupported version: {version}")
    return tuple(int(part) for part in match.groups())  # type: ignore[return-value]


def download_url(url: str, maximum_size: int, timeout: int = 20) -> bytes:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme != "https" or parsed.hostname not in UPDATE_HOSTS:
        raise RuntimeError("The update server returned an unsafe download address.")
    request = urllib.request.Request(
        url,
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": f"TuxDisplay/{VERSION}",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        final = urllib.parse.urlparse(response.geturl())
        if final.scheme != "https" or final.hostname not in UPDATE_HOSTS:
            raise RuntimeError("The update download was redirected to an unsafe server.")
        length = response.headers.get("Content-Length")
        try:
            declared_size = int(length) if length is not None else None
        except ValueError as error:
            raise RuntimeError("The update server returned an invalid download size.") from error
        if declared_size is not None and declared_size > maximum_size:
            raise RuntimeError("The update download is unexpectedly large.")
        payload = response.read(maximum_size + 1)
    if len(payload) > maximum_size:
        raise RuntimeError("The update download is unexpectedly large.")
    return payload


def release_update_from_payload(payload: object) -> dict[str, str] | None:
    if not isinstance(payload, dict) or payload.get("draft") or payload.get("prerelease"):
        raise RuntimeError("GitHub returned invalid release metadata.")
    version = str(payload.get("tag_name", "")).removeprefix("v")
    if version_tuple(version) <= version_tuple(VERSION):
        return None
    package_name = f"tuxdisplay_{version}_all.deb"
    assets = payload.get("assets")
    if not isinstance(assets, list):
        raise RuntimeError("The release does not contain downloadable assets.")
    by_name = {str(asset.get("name", "")): asset for asset in assets if isinstance(asset, dict)}
    package = by_name.get(package_name)
    checksums = by_name.get("SHA256SUMS")
    if not isinstance(package, dict) or not isinstance(checksums, dict):
        raise RuntimeError("The release is missing its Debian package or checksum file.")
    result = {
        "version": version,
        "package_name": package_name,
        "package_url": str(package.get("browser_download_url", "")),
        "checksum_url": str(checksums.get("browser_download_url", "")),
        "package_digest": str(package.get("digest", "")),
        "release_url": str(payload.get("html_url", "")),
        "notes": str(payload.get("body", ""))[:4000],
    }
    for key in ("package_url", "checksum_url"):
        parsed = urllib.parse.urlparse(result[key])
        if parsed.scheme != "https" or parsed.hostname != "github.com":
            raise RuntimeError("The release contains an unsafe asset address.")
    return result


def check_for_update() -> dict[str, str] | None:
    raw = download_url(UPDATE_API, MAX_UPDATE_METADATA)
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RuntimeError("GitHub returned unreadable release metadata.") from error
    return release_update_from_payload(payload)


def verify_update_assets(update: dict[str, str], package_data: bytes, checksum_data: bytes) -> str:
    package_name = update["package_name"]
    try:
        lines = checksum_data.decode("utf-8").splitlines()
    except UnicodeDecodeError as error:
        raise RuntimeError("The release checksum file is unreadable.") from error
    expected = ""
    for line in lines:
        fields = line.split()
        if len(fields) >= 2 and fields[1].lstrip("*").removeprefix("./") == package_name:
            expected = fields[0].lower()
            break
    if not re.fullmatch(r"[0-9a-f]{64}", expected):
        raise RuntimeError("The package checksum is missing from SHA256SUMS.")
    actual = hashlib.sha256(package_data).hexdigest()
    if not secrets.compare_digest(actual, expected):
        raise RuntimeError("The downloaded package failed checksum verification.")
    api_digest = update.get("package_digest", "")
    if api_digest.startswith("sha256:") and not secrets.compare_digest(actual, api_digest[7:].lower()):
        raise RuntimeError("The package does not match GitHub's release digest.")
    return actual


def install_update(update: dict[str, str]) -> tuple[bool, str]:
    try:
        package_data = download_url(update["package_url"], MAX_UPDATE_PACKAGE, timeout=60)
        checksum_data = download_url(update["checksum_url"], MAX_UPDATE_METADATA)
        verify_update_assets(update, package_data, checksum_data)
        with tempfile.TemporaryDirectory(prefix="tuxdisplay-update-") as temporary:
            package_path = Path(temporary) / update["package_name"]
            package_path.write_bytes(package_data)
            metadata = subprocess.run(
                [
                    "dpkg-deb",
                    "--show",
                    "--showformat=${Package}\\n${Version}\\n${Architecture}\\n",
                    str(package_path),
                ],
                check=False,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=20,
            )
            fields = metadata.stdout.splitlines()
            if metadata.returncode or fields != ["tuxdisplay", update["version"], "all"]:
                raise RuntimeError("The downloaded Debian package has unexpected metadata.")
            installed = subprocess.run(
                ["pkexec", "/usr/bin/apt-get", "install", "--yes", str(package_path)],
                check=False,
                timeout=300,
            )
            if installed.returncode:
                return False, "The update was cancelled or could not be installed."
    except (OSError, KeyError, RuntimeError, subprocess.TimeoutExpired, urllib.error.URLError) as error:
        return False, str(error)
    return True, f"TuxDisplay {update['version']} was installed successfully."


def config_dir() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "tuxdisplay"


def state_dir() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "tuxdisplay"


def config_file() -> Path:
    return config_dir() / "config"


def ensure_config() -> dict[str, str]:
    directory = config_dir()
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    state_dir().mkdir(mode=0o700, parents=True, exist_ok=True)
    values = dict(DEFAULTS)
    path = config_file()
    if path.exists():
        for raw_line in path.read_text(encoding="utf-8").splitlines():
            if "=" not in raw_line or raw_line.lstrip().startswith("#"):
                continue
            key, value = raw_line.split("=", 1)
            key = key.strip()
            value = value.strip()
            if key in values:
                values[key] = value
    else:
        save_config(values)
    return validate_config(values)


def validate_config(values: dict[str, str]) -> dict[str, str]:
    result = dict(DEFAULTS)
    if re.fullmatch(r"[0-9]{3,5}x[0-9]{3,5}", values.get("RESOLUTION", "")):
        result["RESOLUTION"] = values["RESOLUTION"]
    if values.get("FPS") in {"15", "30", "60"}:
        result["FPS"] = values["FPS"]
    if values.get("KEEP_AWAKE_WITH_LID_CLOSED") in {"0", "1"}:
        result["KEEP_AWAKE_WITH_LID_CLOSED"] = values["KEEP_AWAKE_WITH_LID_CLOSED"]
    for key, low, high in (
        ("DISPLAY_NUMBER", 1, 99),
        ("WEB_PORT", 1024, 65535),
        ("VNC_PORT", 1024, 65535),
    ):
        try:
            number = int(values.get(key, ""))
        except ValueError:
            continue
        if low <= number <= high:
            result[key] = str(number)
    return result


def save_config(values: dict[str, str]) -> None:
    directory = config_dir()
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    validated = validate_config(values)
    content = "".join(f"{key}={validated[key]}\n" for key in DEFAULTS)
    path = config_file()
    temporary = path.with_suffix(".tmp")
    temporary.write_text(content, encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(path)


def systemctl(*arguments: str, check: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["systemctl", "--user", *arguments],
        check=check,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )


def is_active() -> bool:
    try:
        return systemctl("is-active", "--quiet", SERVICE).returncode == 0
    except FileNotFoundError:
        return False


def client_state_file() -> Path:
    return state_dir() / "clients.json"


def read_client_state() -> dict[str, object]:
    if not is_active():
        return {}
    try:
        payload = json.loads(client_state_file().read_text(encoding="utf-8"))
        if not isinstance(payload, dict):
            return {}
        pid = payload.get("pid")
        if pid is not None:
            pid = int(pid)
            if pid <= 0:
                return {}
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                return {}
            except PermissionError:
                pass
        return payload
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        return {}


def connection_state() -> str:
    """Return disconnected, running, or connected for the UI and tray."""
    if not is_active():
        return "disconnected"
    payload = read_client_state()
    try:
        if int(payload.get("active_streams", 0)) > 0:
            return "connected"
    except (ValueError, TypeError):
        return "running"
    return "running"


def opendisplay_connected() -> bool:
    return bool(read_client_state().get("opendisplay_usb", False))


def opendisplay_receiver() -> str:
    return str(read_client_state().get("opendisplay_status", "")).strip()


def service_action(action: str) -> int:
    ensure_config()
    try:
        result = systemctl(action, SERVICE)
    except FileNotFoundError:
        print("systemctl was not found; TuxDisplay requires a systemd user session.", file=sys.stderr)
        return 1
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or "unknown systemd error"
        print(f"Could not {action} TuxDisplay: {detail}", file=sys.stderr)
    return result.returncode


def network_addresses() -> list[tuple[str, str]]:
    try:
        result = subprocess.run(
            ["ip", "-j", "-4", "address", "show", "up"],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        payload = json.loads(result.stdout)
    except (FileNotFoundError, subprocess.CalledProcessError, json.JSONDecodeError):
        return []
    addresses: list[tuple[str, str]] = []
    for interface in payload:
        name = interface.get("ifname", "")
        if name == "lo":
            continue
        for address in interface.get("addr_info", []):
            local = address.get("local", "")
            if address.get("family") == "inet" and local and not local.startswith("127."):
                addresses.append((name, local))
    return addresses


def interface_driver(interface: str) -> str:
    try:
        return (Path("/sys/class/net") / interface / "device" / "driver").resolve(strict=True).name
    except OSError:
        return ""


def is_usb_network(interface: str, address: str) -> bool:
    return address == USB_GADGET_ADDRESS or interface.startswith("usb") or interface_driver(interface) == "ipheth"


def usb_network_addresses() -> list[tuple[str, str]]:
    return [(interface, address) for interface, address in network_addresses() if is_usb_network(interface, address)]


def usb_device_ids() -> list[str]:
    try:
        result = subprocess.run(
            ["idevice_id", "-l"],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def android_device_states() -> list[dict[str, str]]:
    try:
        result = subprocess.run(
            ["adb", "devices", "-l"],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=3,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return []
    if result.returncode:
        return []
    devices: list[dict[str, str]] = []
    for raw_line in result.stdout.splitlines():
        fields = raw_line.split()
        if len(fields) < 2 or fields[0] == "List":
            continue
        device = {"serial": fields[0], "state": fields[1]}
        for field in fields[2:]:
            if ":" not in field:
                continue
            key, value = field.split(":", 1)
            if key in {"usb", "product", "model", "device", "transport_id"}:
                device[key] = value
        devices.append(device)
    return devices


def usb_status() -> tuple[str, str, str | None]:
    if opendisplay_connected():
        receiver = opendisplay_receiver() or "OpenDisplay receiver"
        return "ready", f"OpenDisplay connected directly through the USB cable ({receiver})", None
    apple_devices = usb_device_ids()
    android_devices = android_device_states()
    authorized_android = [device for device in android_devices if device.get("state") == "device"]
    if authorized_android:
        model = authorized_android[0].get("model", "Android device").replace("_", " ")
        return "android", f"{model} cable ready; open OpenDisplay Android", None
    if any(device.get("state") == "unauthorized" for device in android_devices):
        return "android-authorization", "Unlock Android and allow USB debugging for this computer", None
    if apple_devices:
        return "cable", "iPad cable detected and trusted; open OpenDisplay on the iPad", None
    addresses = usb_network_addresses()
    if addresses:
        interface, address = addresses[0]
        kind = "USB gadget" if address == USB_GADGET_ADDRESS else "iPad USB tethering"
        return "ready", f"{kind} ready on {interface}", f"http://{address}:{ensure_config()['WEB_PORT']}/"
    udc_path = Path("/sys/class/udc")
    if udc_path.is_dir() and any(udc_path.iterdir()):
        return "gadget", "Device-capable USB port available", None
    return "absent", "No trusted iPad or authorized Android USB cable detected", None


def usb_connect(wait_seconds: int = 12) -> tuple[int, str]:
    status, _message, url = usb_status()
    if status == "ready" and opendisplay_connected():
        return 0, "OpenDisplay is connected directly through USB."
    if status == "ready" and url:
        result = 0 if is_active() else service_action("start")
        return result, f"USB connection ready: {url}" if result == 0 else "USB is ready, but the display could not start."

    if status == "android-authorization":
        return 4, "Unlock Android and accept the Allow USB debugging prompt, then try again."

    if status in {"cable", "android"}:
        if status == "cable":
            try:
                validated = subprocess.run(
                    ["idevicepair", "validate"],
                    check=False,
                    text=True,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=8,
                )
                if validated.returncode:
                    subprocess.run(["idevicepair", "pair"], check=False, timeout=30)
            except (FileNotFoundError, subprocess.TimeoutExpired):
                pass
        result = 0 if is_active() else service_action("start")
        if result:
            device = "iPad" if status == "cable" else "Android device"
            return result, f"The {device} is ready, but the display service could not start."
        for _attempt in range(max(1, wait_seconds)):
            if opendisplay_connected():
                return 0, "OpenDisplay connected directly through USB."
            time.sleep(1)
        if status == "android":
            return 0, "The USB display is ready. Open OpenDisplay Android and keep USB debugging enabled."
        return 0, "The USB display is ready. Open the OpenDisplay app on the iPad; Personal Hotspot is not required."

    if status == "gadget":
        try:
            result = subprocess.run(["pkexec", "/usr/sbin/tuxdisplay-usb", "setup"], check=False)
        except FileNotFoundError:
            return 1, "pkexec is unavailable, so USB gadget networking could not be configured."
        if result.returncode:
            return result.returncode, "USB gadget setup was cancelled or failed."
        display_result = 0 if is_active() else service_action("start")
        return display_result, f"USB connection ready: http://{USB_GADGET_ADDRESS}:{ensure_config()['WEB_PORT']}/"

    return 4, "Connect an iPad or Android device with a USB data cable, then open its OpenDisplay app."


def usb_disconnect() -> tuple[int, str]:
    display_result = 0 if not is_active() else service_action("stop")
    if any(address == USB_GADGET_ADDRESS for _interface, address in usb_network_addresses()):
        try:
            subprocess.run(["pkexec", "/usr/sbin/tuxdisplay-usb", "teardown"], check=False)
        except FileNotFoundError:
            pass
    return display_result, "USB display connection closed." if display_result == 0 else "The display connection could not be closed."


def client_path() -> str:
    return "/"


def urls() -> list[tuple[str, str]]:
    port = ensure_config()["WEB_PORT"]
    path = client_path()
    items: list[tuple[str, str]] = []
    seen: set[str] = set()

    def add(label: str, host: str) -> None:
        url = f"http://{host}:{port}{path}"
        if url not in seen:
            seen.add(url)
            items.append((label, url))

    addresses = network_addresses()
    for interface, address in addresses:
        if is_usb_network(interface, address):
            add("USB cable" if address != USB_GADGET_ADDRESS else "USB gadget", address)
    hostname = socket.gethostname().split(".", 1)[0]
    if hostname:
        add("Bonjour", f"{hostname}.local")
    for interface, address in addresses:
        add(interface, address)
    add("This computer", "127.0.0.1")
    return items


def preferred_url() -> str:
    return urls()[0][1]


def password_path() -> Path:
    return config_dir() / "password"


def read_password() -> str:
    path = password_path()
    if not path.exists():
        return "Not created yet — start TuxDisplay"
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return "Unavailable"


def reset_password() -> int:
    directory = config_dir()
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    pin = f"{secrets.randbelow(1_000_000):06d}"
    path = password_path()
    temporary = path.with_suffix(".tmp")
    temporary.write_text(pin + "\n", encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(path)
    rfb = directory / "password.rfb"
    try:
        subprocess.run(
            ["x11vnc", "-storepasswd", pin, str(rfb)],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
    except (FileNotFoundError, subprocess.CalledProcessError) as error:
        print(f"PIN was created, but the fallback VNC password file could not be written: {error}", file=sys.stderr)
        return 1
    rfb.chmod(0o600)
    if is_active() and os.environ.get("TUXDISPLAY_SESSION") != "1":
        service_action("restart")
    print(pin)
    return 0


def launch(command: Sequence[str]) -> int:
    if not command:
        print("Specify an application, for example: tuxdisplay launch xterm", file=sys.stderr)
        return 2
    if not is_active() and service_action("start"):
        return 1
    configuration = ensure_config()
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    native_wayland = os.environ.get("XDG_SESSION_TYPE") == "wayland" and "gnome" in desktop
    if native_wayland:
        log_path = state_dir() / "applications.log"
        try:
            with log_path.open("a", encoding="utf-8") as log:
                subprocess.Popen(
                    list(command),
                    env=os.environ.copy(),
                    stdin=subprocess.DEVNULL,
                    stdout=log,
                    stderr=subprocess.STDOUT,
                    start_new_session=True,
                )
        except FileNotFoundError:
            print(f"Application not found: {command[0]}", file=sys.stderr)
            return 127
        print(f"Launched in the GNOME desktop: {shlex.join(command)}")
        return 0
    environment = os.environ.copy()
    environment["DISPLAY"] = f":{configuration['DISPLAY_NUMBER']}"
    environment["XAUTHORITY"] = str(config_dir() / "Xauthority")
    environment.pop("WAYLAND_DISPLAY", None)
    environment.pop("WAYLAND_SOCKET", None)
    environment["XDG_SESSION_TYPE"] = "x11"
    environment["GDK_BACKEND"] = "x11"
    environment["QT_QPA_PLATFORM"] = "xcb"
    environment["MOZ_ENABLE_WAYLAND"] = "0"
    for _attempt in range(50):
        ready = subprocess.run(
            ["xdpyinfo", "-display", environment["DISPLAY"]],
            env=environment,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if ready.returncode == 0:
            break
        time.sleep(0.1)
    else:
        print("The virtual display did not become ready in time.", file=sys.stderr)
        return 1
    log_path = state_dir() / "applications.log"
    try:
        with log_path.open("a", encoding="utf-8") as log:
            subprocess.Popen(
                list(command),
                env=environment,
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
    except FileNotFoundError:
        print(f"Application not found: {command[0]}", file=sys.stderr)
        return 127
    print(f"Launched on DISPLAY={environment['DISPLAY']}: {shlex.join(command)}")
    return 0


def doctor() -> int:
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    native_wayland = os.environ.get("XDG_SESSION_TYPE") == "wayland" and "gnome" in desktop
    if native_wayland:
        commands = ("systemctl", "gst-inspect-1.0", "ip", "adb")
    else:
        commands = ("systemctl", "Xvfb", "x11vnc", "websockify", "openbox", "tint2", "ip", "adb")
    missing = [name for name in commands if not shutil_which(name)]
    print(f"Display mode: {'native GNOME Wayland monitor' if native_wayland else 'portable X11 workspace'}")
    print(f"Service: {'running' if is_active() else 'stopped'}")
    print(f"Resolution: {ensure_config()['RESOLUTION']}")
    print(f"Frame rate: {ensure_config()['FPS']} FPS")
    print(
        "Lid-close sleep: "
        + ("blocked while TuxDisplay runs" if ensure_config()["KEEP_AWAKE_WITH_LID_CLOSED"] == "1" else "normal")
    )
    print(f"Browser fallback URL: {preferred_url()}")
    receiver_name = opendisplay_receiver()
    print(f"OpenDisplay USB: {'connected to ' + receiver_name if opendisplay_connected() and receiver_name else 'connected' if opendisplay_connected() else 'waiting'}")
    android_devices = android_device_states()
    authorized_android = [device for device in android_devices if device.get("state") == "device"]
    if authorized_android:
        model = authorized_android[0].get("model", "Android device").replace("_", " ")
        print(f"Android USB: authorized ({model})")
    elif any(device.get("state") == "unauthorized" for device in android_devices):
        print("Android USB: authorization required on the device")
    else:
        print("Android USB: not detected")
    receiver = read_client_state().get("receiver", {})
    if isinstance(receiver, dict) and receiver:
        print("Receiver health: " + ", ".join(f"{key}={value}" for key, value in receiver.items()))
    udc_path = Path("/sys/class/udc")
    controllers = list(udc_path.iterdir()) if udc_path.is_dir() else []
    if controllers:
        print("USB gadget capability: available (" + ", ".join(item.name for item in controllers) + ")")
    else:
        print("USB gadget capability: not detected; use tethering, Wi-Fi, or Ethernet")
    if missing:
        print("Missing required commands: " + ", ".join(missing))
        return 1
    print("Runtime dependencies: OK")
    return 0


def shutil_which(command: str) -> str | None:
    path = os.environ.get("PATH", os.defpath)
    for directory in path.split(os.pathsep):
        candidate = Path(directory) / command
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def run_gui(background: bool = False) -> int:
    try:
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("AyatanaAppIndicator3", "0.1")
        from gi.repository import AyatanaAppIndicator3, Gdk, Gio, GLib, Gtk  # type: ignore
    except (ImportError, ValueError) as error:
        print(f"TuxDisplay graphical support is unavailable: {error}", file=sys.stderr)
        return 1

    Gtk.Window.set_default_icon_name("tuxdisplay")

    def add_css_class(widget: Gtk.Widget, name: str) -> None:
        widget.get_style_context().add_class(name)

    class ManagerWindow(Gtk.ApplicationWindow):
        def __init__(self, application: "ManagerApplication") -> None:
            super().__init__(application=application, title=APP_NAME)
            self.application = application
            self.set_default_size(720, 680)
            self.set_resizable(True)
            self.set_icon_name("tuxdisplay")
            self.connect("delete-event", self.on_close)
            self.restart_timeout = 0
            self.restart_reason = ""

            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
            outer.set_border_width(28)
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroller.add(outer)
            self.add(scroller)

            header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            outer.pack_start(header, False, False, 0)
            header.pack_start(Gtk.Image.new_from_icon_name("tuxdisplay", Gtk.IconSize.DIALOG), False, False, 0)
            heading = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            header.pack_start(heading, True, True, 0)
            title = Gtk.Label(label="TuxDisplay")
            title.set_halign(Gtk.Align.START)
            add_css_class(title, "title")
            heading.pack_start(title, False, False, 0)
            subtitle = Gtk.Label(label="Use an iPad or Android tablet as an extended monitor on GNOME Wayland")
            subtitle.set_halign(Gtk.Align.START)
            add_css_class(subtitle, "dim-label")
            heading.pack_start(subtitle, False, False, 0)

            self.status = Gtk.Label()
            self.status.set_halign(Gtk.Align.START)
            add_css_class(self.status, "status")
            outer.pack_start(self.status, False, False, 0)

            grid = Gtk.Grid()
            grid.set_column_spacing(14)
            grid.set_row_spacing(12)
            outer.pack_start(grid, False, False, 0)

            url_label = Gtk.Label(label="Browser fallback URL")
            url_label.set_halign(Gtk.Align.END)
            grid.attach(url_label, 0, 0, 1, 1)
            self.url_entry = Gtk.Entry()
            self.url_entry.set_editable(False)
            self.url_entry.set_hexpand(True)
            grid.attach(self.url_entry, 1, 0, 1, 1)

            pin_label = Gtk.Label(label="Browser fallback PIN")
            pin_label.set_halign(Gtk.Align.END)
            grid.attach(pin_label, 0, 1, 1, 1)
            self.pin_entry = Gtk.Entry()
            self.pin_entry.set_editable(False)
            self.pin_entry.set_visibility(True)
            grid.attach(self.pin_entry, 1, 1, 1, 1)

            resolution_label = Gtk.Label(label="Resolution")
            resolution_label.set_halign(Gtk.Align.END)
            grid.attach(resolution_label, 0, 2, 1, 1)
            self.resolution = Gtk.ComboBoxText()
            for resolution in RESOLUTIONS:
                self.resolution.append_text(resolution)
            current = ensure_config()["RESOLUTION"]
            self.resolution.set_active(RESOLUTIONS.index(current) if current in RESOLUTIONS else 3)
            self.resolution.connect("changed", self.on_resolution_changed)
            grid.attach(self.resolution, 1, 2, 1, 1)

            frame_rate_label = Gtk.Label(label="Frame rate")
            frame_rate_label.set_halign(Gtk.Align.END)
            grid.attach(frame_rate_label, 0, 3, 1, 1)
            self.frame_rate = Gtk.ComboBoxText()
            for value in FRAME_RATES:
                self.frame_rate.append_text(f"{value} FPS")
            current_fps = ensure_config()["FPS"]
            self.frame_rate.set_active(FRAME_RATES.index(current_fps) if current_fps in FRAME_RATES else 1)
            self.frame_rate.connect("changed", self.on_frame_rate_changed)
            grid.attach(self.frame_rate, 1, 3, 1, 1)

            keep_awake_label = Gtk.Label(label="Keep awake with lid closed")
            keep_awake_label.set_halign(Gtk.Align.END)
            grid.attach(keep_awake_label, 0, 4, 1, 1)
            self.keep_awake = Gtk.Switch()
            self.keep_awake.set_halign(Gtk.Align.START)
            self.keep_awake.set_active(ensure_config()["KEEP_AWAKE_WITH_LID_CLOSED"] == "1")
            self.keep_awake.connect("notify::active", self.on_keep_awake_changed)
            grid.attach(self.keep_awake, 1, 4, 1, 1)

            usb_label = Gtk.Label(label="USB cable")
            usb_label.set_halign(Gtk.Align.END)
            grid.attach(usb_label, 0, 5, 1, 1)
            self.usb_status_label = Gtk.Label()
            self.usb_status_label.set_halign(Gtk.Align.START)
            self.usb_status_label.set_line_wrap(True)
            grid.attach(self.usb_status_label, 1, 5, 1, 1)

            lid_note = Gtk.Label(
                label=(
                    "Lid-close protection also blocks manual and idle suspend while TuxDisplay is running. "
                    "Keep the closed laptop connected to power and well ventilated."
                )
            )
            lid_note.set_line_wrap(True)
            lid_note.set_halign(Gtk.Align.START)
            add_css_class(lid_note, "dim-label")
            outer.pack_start(lid_note, False, False, 0)

            controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            outer.pack_start(controls, False, False, 0)
            self.start_button = Gtk.Button(label="Start display")
            add_css_class(self.start_button, "suggested-action")
            self.start_button.connect("clicked", self.on_start)
            controls.pack_start(self.start_button, False, False, 0)
            self.usb_button = Gtk.Button(label="Connect OpenDisplay")
            self.usb_button.connect("clicked", self.on_usb)
            controls.pack_start(self.usb_button, False, False, 0)
            self.stop_button = Gtk.Button(label="Close connection")
            self.stop_button.connect("clicked", self.on_stop)
            controls.pack_start(self.stop_button, False, False, 0)
            copy_button = Gtk.Button(label="Copy URL")
            copy_button.connect("clicked", self.on_copy)
            controls.pack_start(copy_button, False, False, 0)
            preview_button = Gtk.Button(label="Open preview")
            preview_button.connect("clicked", self.on_preview)
            controls.pack_start(preview_button, False, False, 0)

            outer.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)
            app_title = Gtk.Label(label="Launch an app in the current desktop")
            app_title.set_halign(Gtk.Align.START)
            add_css_class(app_title, "section-title")
            outer.pack_start(app_title, False, False, 0)
            launch_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            outer.pack_start(launch_row, False, False, 0)
            self.command_entry = Gtk.Entry()
            self.command_entry.set_placeholder_text("xterm, firefox --new-instance, libreoffice …")
            self.command_entry.set_hexpand(True)
            self.command_entry.connect("activate", self.on_launch)
            launch_row.pack_start(self.command_entry, True, True, 0)
            launch_button = Gtk.Button(label="Launch")
            launch_button.connect("clicked", self.on_launch)
            launch_row.pack_start(launch_button, False, False, 0)

            usb_note = Gtk.Label(
                label=(
                    "Install and open OpenDisplay on the tablet, then connect a USB data cable. "
                    "On Android, enable USB debugging and approve this computer once. "
                    "The direct connection works without Wi-Fi or an IP address."
                )
            )
            usb_note.set_line_wrap(True)
            usb_note.set_halign(Gtk.Align.START)
            add_css_class(usb_note, "dim-label")
            outer.pack_start(usb_note, False, False, 0)

            outer.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)
            update_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            outer.pack_start(update_row, False, False, 0)
            self.version_label = Gtk.Label(label=f"Version {VERSION}")
            self.version_label.set_halign(Gtk.Align.START)
            update_row.pack_start(self.version_label, True, True, 0)
            self.update_button = Gtk.Button(label="Check for updates")
            self.update_button.connect("clicked", self.on_update)
            update_row.pack_start(self.update_button, False, False, 0)

            self.message = Gtk.Label()
            self.message.set_line_wrap(True)
            self.message.set_halign(Gtk.Align.START)
            outer.pack_start(self.message, False, False, 0)
            self.refresh()
            self.update_update_button()
            self.show_all()

        def on_close(self, _window: Gtk.Window, _event: object) -> bool:
            self.hide()
            return True

        def show_message(self, text: str) -> None:
            self.message.set_label(text)

        def refresh(self) -> bool:
            state = connection_state()
            labels = {
                "connected": "● Connected — tablet is viewing the monitor",
                "running": "● Running — waiting for an OpenDisplay tablet",
                "disconnected": "○ Disconnected",
            }
            self.status.set_label(labels[state])
            context = self.status.get_style_context()
            context.remove_class("success")
            context.remove_class("warning")
            if state == "connected":
                context.add_class("success")
            elif state == "running":
                context.add_class("warning")
            usb_kind, usb_message, usb_url = usb_status()
            self.usb_status_label.set_label(usb_message)
            self.usb_button.set_label("OpenDisplay connected" if usb_kind == "ready" and not usb_url else "Connect OpenDisplay")
            self.url_entry.set_text(usb_url or preferred_url())
            self.pin_entry.set_text(read_password())
            self.start_button.set_sensitive(state == "disconnected")
            self.stop_button.set_sensitive(state != "disconnected")
            return GLib.SOURCE_CONTINUE

        def update_update_button(self) -> None:
            if self.application.update_installed:
                self.update_button.set_label("Restart TuxDisplay")
            elif self.application.available_update is not None:
                self.update_button.set_label(f"Install {self.application.available_update['version']}")
            else:
                self.update_button.set_label("Check for updates")
            self.update_button.set_sensitive(not self.application.update_busy)

        def on_start(self, _button: Gtk.Button) -> None:
            result = service_action("start")
            self.show_message("Display started. Open OpenDisplay on the tablet." if result == 0 else "The display could not start. Run ‘tuxdisplay status’ for details.")
            self.refresh()

        def on_stop(self, _button: Gtk.Button) -> None:
            result = service_action("stop")
            self.show_message("Display stopped." if result == 0 else "The display could not be stopped.")
            self.refresh()

        def on_usb(self, _button: Gtk.Button) -> None:
            self.usb_button.set_sensitive(False)
            self.show_message("Connecting to OpenDisplay through USB…")

            def finished(_result: int, message: str) -> bool:
                self.usb_button.set_sensitive(True)
                self.show_message(message)
                self.refresh()
                return GLib.SOURCE_REMOVE

            def worker() -> None:
                result, message = usb_connect()
                GLib.idle_add(finished, result, message)

            threading.Thread(target=worker, name="tuxdisplay-usb-connect", daemon=True).start()

        def on_copy(self, _button: Gtk.Button) -> None:
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(self.url_entry.get_text(), -1)
            self.show_message("URL copied.")

        def on_preview(self, _button: Gtk.Button) -> None:
            try:
                Gio.AppInfo.launch_default_for_uri(self.url_entry.get_text(), None)
                self.show_message("Opened a local preview in your browser.")
            except GLib.Error as error:
                self.show_message(f"Could not open the browser: {error.message}")

        def on_launch(self, _widget: Gtk.Widget) -> None:
            try:
                command = shlex.split(self.command_entry.get_text())
            except ValueError as error:
                self.show_message(f"Invalid command: {error}")
                return
            if not command:
                self.show_message("Enter an application command first.")
                return
            result = launch(command)
            self.show_message("Application launched. Drag its window to the tablet monitor." if result == 0 else "The application could not be launched.")

        def on_resolution_changed(self, dropdown: Gtk.ComboBoxText) -> None:
            selected = dropdown.get_active()
            if not 0 <= selected < len(RESOLUTIONS):
                return
            configuration = ensure_config()
            if configuration["RESOLUTION"] == RESOLUTIONS[selected]:
                return
            configuration["RESOLUTION"] = RESOLUTIONS[selected]
            save_config(configuration)
            if is_active():
                self.schedule_display_restart("Resolution")

        def on_frame_rate_changed(self, dropdown: Gtk.ComboBoxText) -> None:
            selected = dropdown.get_active()
            if not 0 <= selected < len(FRAME_RATES):
                return
            configuration = ensure_config()
            if configuration["FPS"] == FRAME_RATES[selected]:
                return
            configuration["FPS"] = FRAME_RATES[selected]
            save_config(configuration)
            if is_active():
                self.schedule_display_restart("Frame rate")

        def on_keep_awake_changed(self, switch: Gtk.Switch, _parameter: object) -> None:
            configuration = ensure_config()
            selected = "1" if switch.get_active() else "0"
            if configuration["KEEP_AWAKE_WITH_LID_CLOSED"] == selected:
                return
            configuration["KEEP_AWAKE_WITH_LID_CLOSED"] = selected
            save_config(configuration)
            if is_active():
                self.schedule_display_restart("Lid-close protection")
            elif selected == "1":
                self.show_message("Lid-close protection will activate when the display starts.")
            else:
                self.show_message("Normal system sleep behavior restored.")

        def schedule_display_restart(self, reason: str) -> None:
            self.restart_reason = reason
            if self.restart_timeout:
                GLib.source_remove(self.restart_timeout)
            self.restart_timeout = GLib.timeout_add(500, self.begin_display_restart)
            self.show_message(f"{reason} saved. Restarting the display…")

        def begin_display_restart(self) -> bool:
            reason = self.restart_reason
            self.restart_timeout = 0

            def worker() -> None:
                result = service_action("restart")
                message = (
                    f"{reason} changed. OpenDisplay will reconnect automatically."
                    if result == 0
                    else "The display could not restart. Run ‘tuxdisplay status’ for details."
                )
                GLib.idle_add(self.show_message, message)
                GLib.idle_add(self.refresh)

            threading.Thread(target=worker, name="tuxdisplay-settings-restart", daemon=True).start()
            return GLib.SOURCE_REMOVE

        def on_update(self, _button: Gtk.Button) -> None:
            if self.application.update_installed:
                self.application.restart_application()
            elif self.application.available_update is not None:
                self.application.install_available_update()
            else:
                self.application.check_updates(show_current=True)

    class ManagerApplication(Gtk.Application):
        def __init__(self, background_start: bool) -> None:
            super().__init__(application_id="io.github.tuxdisplay.Manager", flags=Gio.ApplicationFlags.FLAGS_NONE)
            self.background_start = background_start
            self.window: ManagerWindow | None = None
            self.available_update: dict[str, str] | None = None
            self.update_busy = False
            self.update_installed = False

        def do_startup(self) -> None:
            Gtk.Application.do_startup(self)
            self.hold()
            self.setup_indicator()
            GLib.timeout_add_seconds(4, self.automatic_update_check)

        def do_activate(self) -> None:
            if self.background_start:
                self.background_start = False
                return
            self.present_manager()

        def setup_indicator(self) -> None:
            self.indicator = AyatanaAppIndicator3.Indicator.new(
                "tuxdisplay",
                "tuxdisplay-disconnected",
                AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS,
            )
            self.indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
            self.indicator.set_title("TuxDisplay")
            menu = Gtk.Menu()
            self.status_item = Gtk.MenuItem(label="Disconnected")
            self.status_item.set_sensitive(False)
            menu.append(self.status_item)
            menu.append(Gtk.SeparatorMenuItem())
            open_item = Gtk.MenuItem(label="Open TuxDisplay")
            open_item.connect("activate", lambda _item: self.present_manager())
            menu.append(open_item)
            self.start_item = Gtk.MenuItem(label="Start display")
            self.start_item.connect("activate", self.start_display)
            menu.append(self.start_item)
            self.usb_item = Gtk.MenuItem(label="Connect OpenDisplay with USB")
            self.usb_item.connect("activate", self.connect_usb)
            menu.append(self.usb_item)
            self.close_item = Gtk.MenuItem(label="Close connection")
            self.close_item.connect("activate", self.close_connection)
            menu.append(self.close_item)
            menu.append(Gtk.SeparatorMenuItem())
            self.update_item = Gtk.MenuItem(label="Check for updates")
            self.update_item.connect("activate", self.on_update_item)
            menu.append(self.update_item)
            quit_item = Gtk.MenuItem(label="Quit TuxDisplay")
            quit_item.connect("activate", lambda _item: self.quit())
            menu.append(quit_item)
            menu.show_all()
            self.indicator.set_menu(menu)
            self.refresh_indicator()
            GLib.timeout_add_seconds(2, self.refresh_indicator)

        def present_manager(self) -> None:
            if self.window is None:
                self.window = ManagerWindow(self)
            self.window.show_all()
            self.window.present()

        def notify_user(self, message: str) -> None:
            notification = Gio.Notification.new("TuxDisplay")
            notification.set_body(message)
            notification.set_icon(Gio.ThemedIcon.new("tuxdisplay"))
            self.send_notification("tuxdisplay-status", notification)

        def refresh_indicator(self) -> bool:
            state = connection_state()
            details = {
                "connected": ("tuxdisplay-connected", "Connected — tablet is viewing"),
                "running": ("tuxdisplay-running", "Running — waiting for tablet"),
                "disconnected": ("tuxdisplay-disconnected", "Disconnected — display stopped"),
            }
            icon, label = details[state]
            self.indicator.set_icon_full(icon, label)
            self.status_item.set_label(label)
            self.start_item.set_sensitive(state == "disconnected")
            self.close_item.set_sensitive(state != "disconnected")
            if self.window is not None:
                self.window.refresh()
            return GLib.SOURCE_CONTINUE

        def start_display(self, _item: Gtk.MenuItem) -> None:
            result = service_action("start")
            self.notify_user("Display started." if result == 0 else "The display could not start.")
            self.refresh_indicator()

        def connect_usb(self, _item: Gtk.MenuItem) -> None:
            self.usb_item.set_sensitive(False)

            def worker() -> None:
                _result, message = usb_connect()
                GLib.idle_add(self.notify_user, message)
                GLib.idle_add(self.usb_item.set_sensitive, True)
                GLib.idle_add(self.refresh_indicator)

            threading.Thread(target=worker, name="tuxdisplay-usb-connect", daemon=True).start()

        def close_connection(self, _item: Gtk.MenuItem) -> None:
            result = service_action("stop")
            self.notify_user("Connection closed." if result == 0 else "The connection could not be closed.")
            self.refresh_indicator()

        def automatic_update_check(self) -> bool:
            self.check_updates(show_current=False)
            return GLib.SOURCE_REMOVE

        def on_update_item(self, _item: Gtk.MenuItem) -> None:
            if self.update_installed:
                self.restart_application()
            elif self.available_update is not None:
                self.install_available_update()
            else:
                self.check_updates(show_current=True)

        def check_updates(self, show_current: bool) -> None:
            if self.update_busy:
                return
            self.update_busy = True
            self.update_item.set_sensitive(False)
            if show_current and self.window is not None:
                self.window.show_message("Checking for updates…")
            if self.window is not None:
                self.window.update_update_button()

            def finished(update: dict[str, str] | None, error: str) -> bool:
                self.update_busy = False
                self.update_item.set_sensitive(True)
                if error:
                    if show_current and self.window is not None:
                        self.window.show_message(f"Update check failed: {error}")
                elif update is None:
                    self.available_update = None
                    self.update_item.set_label("Check for updates")
                    if show_current and self.window is not None:
                        self.window.show_message(f"TuxDisplay {VERSION} is up to date.")
                else:
                    self.available_update = update
                    self.update_item.set_label(f"Install update {update['version']}")
                    self.notify_user(f"TuxDisplay {update['version']} is available.")
                    if self.window is not None:
                        self.window.show_message(
                            f"TuxDisplay {update['version']} is available. The package will be verified before installation."
                        )
                if self.window is not None:
                    self.window.update_update_button()
                return GLib.SOURCE_REMOVE

            def worker() -> None:
                try:
                    update = check_for_update()
                    error = ""
                except (OSError, RuntimeError, ValueError, urllib.error.URLError) as caught:
                    update = None
                    error = str(caught)
                GLib.idle_add(finished, update, error)

            threading.Thread(target=worker, name="tuxdisplay-update-check", daemon=True).start()

        def install_available_update(self) -> None:
            update = self.available_update
            if update is None or self.update_busy:
                return
            self.update_busy = True
            self.update_item.set_sensitive(False)
            if self.window is not None:
                self.window.show_message("Downloading and verifying the update… System authentication will be requested.")
                self.window.update_update_button()

            def finished(success: bool, message: str) -> bool:
                self.update_busy = False
                self.update_item.set_sensitive(True)
                if success:
                    self.update_installed = True
                    self.update_item.set_label("Restart TuxDisplay")
                    systemctl("daemon-reload")
                    service_action("restart")
                    self.notify_user(message)
                    if self.window is not None:
                        self.window.show_message(message + " Restart TuxDisplay to use the new application version.")
                elif self.window is not None:
                    self.window.show_message(f"Update failed: {message}")
                if self.window is not None:
                    self.window.update_update_button()
                return GLib.SOURCE_REMOVE

            def worker() -> None:
                success, message = install_update(update)
                GLib.idle_add(finished, success, message)

            threading.Thread(target=worker, name="tuxdisplay-update-install", daemon=True).start()

        def restart_application(self) -> None:
            os.execv("/usr/bin/tuxdisplay", ["/usr/bin/tuxdisplay", "gui"])

    css = b"""
        .title { font-size: 24px; font-weight: bold; }
        .status { font-size: 17px; font-weight: bold; }
        .section-title { font-size: 15px; font-weight: bold; }
        .success { color: #2ec27e; }
        .warning { color: #d99b11; }
        .dim-label { opacity: 0.72; }
        entry, button, combobox { min-height: 34px; }
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(css)
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    try:
        return ManagerApplication(background).run([sys.argv[0]])
    except KeyboardInterrupt:
        return 0


def print_status() -> int:
    running = is_active()
    print(f"TuxDisplay is {'running' if running else 'stopped'}.")
    mode_path = state_dir() / "mode"
    try:
        mode = mode_path.read_text(encoding="utf-8").strip()
    except OSError:
        mode = "unknown"
    labels = {"wayland": "native GNOME Wayland extended monitor", "x11": "portable X11 workspace"}
    print(f"Mode: {labels.get(mode, mode)}")
    print(f"Frame rate: {ensure_config()['FPS']} FPS")
    print(
        "Lid-close sleep: "
        + ("blocked while TuxDisplay runs" if ensure_config()["KEEP_AWAKE_WITH_LID_CLOSED"] == "1" else "normal")
    )
    receiver_name = opendisplay_receiver()
    print(f"OpenDisplay USB: {'connected to ' + receiver_name if opendisplay_connected() and receiver_name else 'connected' if opendisplay_connected() else 'waiting'}")
    android_devices = android_device_states()
    authorized_android = [device for device in android_devices if device.get("state") == "device"]
    if authorized_android:
        model = authorized_android[0].get("model", "Android device").replace("_", " ")
        print(f"Android USB: authorized ({model})")
    elif any(device.get("state") == "unauthorized" for device in android_devices):
        print("Android USB: authorization required on the device")
    else:
        print("Android USB: not detected")
    receiver = read_client_state().get("receiver", {})
    if isinstance(receiver, dict) and receiver:
        print("Receiver health: " + ", ".join(f"{key}={value}" for key, value in receiver.items()))
    print(f"Browser fallback URL: {preferred_url()}")
    print(f"Browser fallback PIN: {read_password()}")
    if not running:
        try:
            result = systemctl("status", SERVICE)
            if result.returncode and result.stderr.strip():
                print(result.stderr.strip(), file=sys.stderr)
        except FileNotFoundError:
            pass
    return 0 if running else 3


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Use an iPad or Android tablet as a USB secondary Linux monitor.")
    subparsers = parser.add_subparsers(dest="command")
    for command in ("start", "stop", "restart", "status", "url", "doctor", "tray"):
        subparsers.add_parser(command)
    gui_parser = subparsers.add_parser("gui")
    gui_parser.add_argument("--background", action="store_true", help=argparse.SUPPRESS)
    usb_parser = subparsers.add_parser("usb")
    usb_parser.add_argument("action", choices=("connect", "disconnect", "status"), nargs="?", default="status")
    password_parser = subparsers.add_parser("password")
    password_parser.add_argument("--reset", action="store_true", help="generate a new six-digit access PIN")
    launch_parser = subparsers.add_parser("launch")
    launch_parser.add_argument("application", nargs=argparse.REMAINDER)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    parser = build_parser()
    arguments = parser.parse_args(argv)
    command = arguments.command or "gui"
    if command in {"start", "stop", "restart"}:
        return service_action(command)
    if command == "status":
        return print_status()
    if command == "url":
        print(preferred_url())
        return 0
    if command == "password":
        if arguments.reset:
            return reset_password()
        print(read_password())
        return 0
    if command == "launch":
        return launch(arguments.application)
    if command == "doctor":
        return doctor()
    if command == "usb":
        if arguments.action == "connect":
            result, message = usb_connect()
        elif arguments.action == "disconnect":
            result, message = usb_disconnect()
        else:
            status, message, url = usb_status()
            result = 0 if status == "ready" else 4
            if url:
                message = f"{message}: {url}"
        print(message)
        return result
    if command == "tray":
        return run_gui(background=True)
    if command == "gui":
        return run_gui(background=getattr(arguments, "background", False))
    parser.error(f"unknown command: {command}")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
