[Unit]
Description=TuxDisplay OpenDisplay USB and browser virtual display
Documentation=file:///usr/share/doc/tuxdisplay/README.md
After=graphical-session.target network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/tuxdisplay/tuxdisplay-session
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=default.target
